# WhisperX
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BATCH_SIZE=4
DEFAULT_LANGUAGE=en

# Qwen2.5-3B summaries (Ollama by default — local qwen2.5:3b)
QWEN_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen2.5:3b

# Hugging Face fallback: QWEN_BACKEND=transformers and QWEN_MODEL=Qwen/Qwen2.5-3B-Instruct
HF_TOKEN=

# BGE-M3
BGE_MODEL=BAAI/bge-m3
EMBED_BATCH_SIZE=16

# Paths (relative to repository root unless absolute)
MEDIA_DIR=data/media
TRANSCRIPTS_DIR=data/transcripts
SUMMARIES_DIR=data/summaries
EMBEDDINGS_DIR=data/embeddings

TOP_K=5
